# =====================================================
#  YOUR SECRET SETTINGS - copy this file, rename the copy to .env, and fill it in.
#  This file is in .gitignore, so it never goes to GitHub.
# =====================================================

# Your key from https://console.groq.com/keys (starts with "gsk_"). No spaces around "=".
GROQ_API_KEY=paste-your-groq-api-key-here

# Your bot's personality. Keep the double quotes.
# You can write several lines between the quotes.
SYSTEM_PROMPT="You are a friendly and helpful assistant.
Keep your answers short, clear and easy to understand."
